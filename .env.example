# All values are server-only. Copy to .env.local and restart the app.
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=
# Safe defaults for the current Voyage trial account. Raise only to limits
# confirmed under the key's organization/project Rate Limits in Voyage.
VOYAGE_REQUESTS_PER_MINUTE=3
VOYAGE_TOKENS_PER_MINUTE=10000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: required for the shared Voyage rate-budget RPCs. Knowledge
# operations still use the authenticated user's JWT and tenant RLS.

SUPABASE_PUBLISHABLE_KEY=

# Resolvo's origin; use the exact HTTPS deployment origin in production.
# Supabase redirects back to APP_URL/auth/callback after sign-in.
# Google Cloud's Authorized redirect URI is SUPABASE_URL/auth/v1/callback.
# Google client ID/secret belong in Supabase's Google provider, not this file.
APP_URL=http://localhost:3000
