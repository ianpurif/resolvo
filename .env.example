
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=

VOYAGE_REQUESTS_PER_MINUTE=3
VOYAGE_TOKENS_PER_MINUTE=10000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


SUPABASE_PUBLISHABLE_KEY=

APP_URL=http://localhost:3000

# Third-party integration credentials are encrypted at rest with this key.
# Generate a random 32-byte key, encode as standard base64, and keep it backed up.
INTEGRATION_ENCRYPTION_KEY=
# At least 32 random characters. Required only for scheduled HTTP worker calls.
INTEGRATION_SYNC_SECRET=

# Optional OAuth apps. Register APP_URL/api/integrations/oauth/callback.
# Google is shared by Drive and Gmail; Microsoft by files and Outlook Mail.
INTEGRATION_GOOGLE_CLIENT_ID=
INTEGRATION_GOOGLE_CLIENT_SECRET=
INTEGRATION_MICROSOFT_CLIENT_ID=
INTEGRATION_MICROSOFT_CLIENT_SECRET=
INTEGRATION_GITHUB_CLIENT_ID=
INTEGRATION_GITHUB_CLIENT_SECRET=
INTEGRATION_DROPBOX_CLIENT_ID=
INTEGRATION_DROPBOX_CLIENT_SECRET=
INTEGRATION_BOX_CLIENT_ID=
INTEGRATION_BOX_CLIENT_SECRET=
